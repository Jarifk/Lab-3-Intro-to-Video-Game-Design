theme_override_font_sizes/font_size = 40
text = "Greetings, wizard! Welcome to the Enchanted Caves. You are here to collect 
potions for your next spell. Use your agility, powers, and strategical skills to 
navigate the caves and collect as many potions as you can! But beware of the 
dangers– viscious goblins and treacherous ledges stand in your way."

[node name="Label2" type="Label" parent="." unique_id=230817756]
