theme_override_fonts/font = ExtResource("2_ehuit")
theme_override_font_sizes/font_size = 40
text = "
- Press the left/right arrows keys to move left/right
- Press the up arrow key to jump
- Press the spacebar to attack goblins with your powers
- Walk through potions to collect them
- If you fall off a ledge or are attacked by a goblin, 
you will be sent back to the start of the level
- Collect as many potions as you can!
"

